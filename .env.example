# passbook — environment template
#
# Copy to .env and fill in.  `make env` does this for you and generates the
# two secrets safely:
#
#     make env
#
# .env is gitignored and must stay that way.  It holds database credentials,
# the Firefly encryption key, and your bank account number.
#
# VALUE RULES — read before hand-editing:
#   * Values consumed by docker compose (everything above the passbook block)
#     must be UNQUOTED — compose keeps quotes as part of the value.
#   * A value containing spaces must be QUOTED, because `make check`, `backup`
#     and `restore` read this file with `set -a; . ./.env`, and an unquoted
#     space makes the shell try to run the second word as a command.
#     Only the passbook block below has such values, and none of those reach
#     docker compose — so the two rules never collide.
#   * No `$` and no `#` in any value.  docker compose interpolates `${...}`
#     into docker-compose.yml, and `#` starts a comment.  Stick to A-Za-z0-9
#     for the generated secrets and you will never hit this.
#   * No trailing spaces.

# ── Firefly III application ──────────────────────────────────────────────────

# Laravel encryption key. EXACTLY 32 characters, alphanumeric.
# Generate:  head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32 && echo
#
# WARNING: changing this after first login makes existing encrypted fields
# unreadable. Set it once, then leave it alone. Back it up with `make backup`.
APP_KEY=

# Host port for Firefly. The container always listens on 8080; this is only
# which host port `make up` binds it to, and APP_URL / FIREFLY_URL below must
# name the same number. Change it if the bind fails with "address already in
# use" while nothing inside the distro appears to be listening — on WSL with
# `networkingMode=mirrored` the distro shares Windows's port space, so a
# Windows service on 8080 is enough. `netstat.exe -ano | grep :8080` names it.
FIREFLY_HOST_PORT=8080

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
# Instance admin contact. Use the address your Firefly login is registered
# under. `make check` warns while this is still the placeholder.
SITE_OWNER=you@example.com
DEFAULT_LANGUAGE=en_US
TZ=Asia/Kolkata

# Firefly sits behind nothing, but the container's own nginx forwards to
# php-fpm and Laravel needs to trust it. See SPEC §5.
TRUSTED_PROXIES=**

# Logging. `stack` fans out to ['daily', 'stdout']; stdout is what `make logs`
# shows. Other valid values: single, stdout, daily, syslog, errorlog, papertrail.
# Anything else throws "Log [x] is not defined" at boot — in particular
# `docker_out` was valid in Firefly v5.x but no longer exists in v6.
# Config is cached at container start, so changes need `make down && make up`.
LOG_CHANNEL=stack
APP_LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# Consumed twice: by Firefly (DB_*) and by the postgres container, which
# docker-compose.yml maps onto POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD.

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
# Generate:  head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 40 && echo
DB_PASSWORD=

# ── passbook (Phase 2+; unused by the Docker stack) ──────────────────────────

# Firefly Personal Access Token, from **Options → Remote access and tokens**
# (/profile/oauth), after first login. Verified against v6.6.6 — older docs say
# "Profile → OAuth", which no longer exists.
#
# NOT the "Command line token" on the Profile page. That is a different
# credential, it will not authenticate the API, and it is an easy mis-grab.
# A PAT is a JWT: ~1000 chars, starts `eyJ`, two dots. If yours is short and
# has no dots, you took the wrong one.
#
# Expires 365 days after issue. `passbook doctor` warns within 30 days.
# Deliberately NOT passed into any container — it is read by the CLI only.
FIREFLY_TOKEN=

FIREFLY_URL=http://localhost:8080

# Full Canara savings account number. Guards against pushing a misfiled
# statement from a different account. SPEC §6.7.
PASSBOOK_ACCOUNT_NUMBER=

# The Firefly asset account statements are posted into. QUOTE IT — the name
# almost certainly contains spaces. `passbook doctor` lists the candidates and
# refuses to guess, because posting a statement into the wrong account is
# tedious to unpick.
#
# Its opening balance must equal the statement's Opening Balance on or before
# the first transaction date, or Firefly's balance will not match the bank.
# Firefly's own setup wizard invites you to enter your CURRENT balance instead,
# which counts the closing figure twice and leaves the account negative.
#
# Left blank on purpose: it has to be the exact name of an account that exists
# in YOUR Firefly. `make setup` lists them and writes this line for you.
PASSBOOK_ASSET_ACCOUNT=""
# Both variables above are the SINGLE-ACCOUNT form and still work. With more
# than one account the registry in config/accounts.yaml replaces them — it is
# written for you by the first statement you upload. SPEC §21.3.

# Withdrawals above this get tagged `large-oneoff`. SPEC D6.
LARGE_TXN_THRESHOLD=10000

# ── web UI (Phase 7, `make up` -> 127.0.0.1:8081) ────────────────────────────
# Generate the first two with:  make web-password
# The plaintext password is never written here, to the repo, or to a log —
# only the Werkzeug hash. Quote the hash: it contains `$`.
PASSBOOK_WEB_USER=
PASSBOOK_WEB_PASSWORD_HASH=

# Flask session signing key. `make env` generates one.
PASSBOOK_WEB_SECRET=

# ── off-site backup (`make backup-remote`) ───────────────────────────────────
# Config only. THE PASSPHRASE IS NOT HERE AND MUST NOT BE PUT HERE — this file
# is read by make and by docker compose, and a passphrase stored beside the
# thing it protects is not protecting much. It lives at
# ~/.config/passbook/backup-passphrase (override with PASSBOOK_PASSPHRASE_FILE),
# mode 600, outside the repo. `make backup-remote` refuses to run otherwise.
#
# Create it ONLY with `make backup-passphrase`, which refuses to overwrite an
# existing one. A plain `> ` redirect would destroy a working passphrase
# silently and make every archive already in Drive permanently undecryptable.
#
# Losing that passphrase makes every uploaded archive permanently unreadable.

# rclone remote and folder, e.g. gdrive:passbook-backups. Created by
# `rclone config`, a manual interactive OAuth step — see README.
PASSBOOK_RCLONE_REMOTE=

# How many of each artefact to keep, locally and remotely.
PASSBOOK_BACKUP_KEEP=14

# OPTIONAL. Only needed if you upload a PDF statement instead of the XLS.
# Absent is fine until then; the loader's error names this variable.
#
# MEASURED: it is the LAST FOUR DIGITS of the account number, not the Customer
# ID. It is therefore NOT credential-class — it is the same four digits the UI
# already prints as the masked account (****NNNN), so masking it would be
# theatre. Earlier guidance in this file said to treat it as a credential; that
# was wrong and is corrected here.
#
# What IS worth knowing: the PDF's own protection is nominal. /V 1 /R 2 is
# RC4-40 over a four-digit secret — ten thousand combinations against a broken
# cipher. Never email these files or leave them in shared storage on the
# assumption that the password protects them. SPEC §6.8.
CANARA_PDF_PASSWORD=
