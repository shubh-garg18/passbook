# passbook — environment template
#
# Copy to .env and fill in.  `make env` does this for you and generates the
# two secrets safely:
#
#     make env
#
# .env is gitignored and must stay that way.  It holds database credentials
# and your bank account number.
#
# VALUE RULES — read before hand-editing:
#   * Values consumed by docker compose (everything above the passbook block)
#     must be UNQUOTED — compose keeps quotes as part of the value.
#   * A value containing spaces must be QUOTED, because `make check`, `backup`
#     and `restore` read this file with `set -a; . ./.env`, and an unquoted
#     space makes the shell try to run the second word as a command.
#     Only the passbook block below has such values, and none of those reach
#     docker compose — so the two rules never collide.
#   * No `$` and no `#` in any value.  docker compose interpolates `${...}`
#     into docker-compose.yml, and `#` starts a comment.  Stick to A-Za-z0-9
#     for the generated secrets and you will never hit this.
#   * No trailing spaces.

# ── Database ─────────────────────────────────────────────────────────────────
# The ledger lives here, in passbook's own tables, in a schema of its own.
# docker-compose.yml maps these onto POSTGRES_DB / POSTGRES_USER /
# POSTGRES_PASSWORD, and assembles the web container's connection string from
# them.
#
# Upgrading from an older install? Leave these exactly as they are. passbook
# creates its own schema inside the database that already exists; nothing is
# read out of the old tables and nothing is dropped.
TZ=Asia/Kolkata

DB_DATABASE=passbook
DB_USERNAME=passbook
# Generate:  head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 40 && echo
DB_PASSWORD=

# Which host port `make up` publishes the database on, for the CLI — which runs
# on the host, while the web container reaches the same database over the
# compose network. 5433 rather than 5432 so a Postgres already installed on
# this machine is not in the way. Bound to 127.0.0.1 only.
PASSBOOK_DB_PORT=5433

# ── passbook ─────────────────────────────────────────────────────────────────

# Full bank account number. Guards against importing a misfiled statement from
# a different account.
PASSBOOK_ACCOUNT_NUMBER=

# The asset account statements are written into. QUOTE IT — the name almost
# certainly contains spaces. Nothing guesses between several, because writing a
# statement into the wrong account is tedious to unpick.
#
# It is created for you by the first statement you upload, with its opening
# balance taken from that statement. That matters: an account opened at zero is
# short by the opening amount forever, and the balance can never equal the
# bank's. `passbook verify-ledger` says so if it ever happens.
PASSBOOK_ASSET_ACCOUNT=""
# Both variables above are the SINGLE-ACCOUNT form and still work. With more
# than one account the registry in config/accounts.yaml replaces them — it is
# written for you by the first statement you upload.

# Withdrawals above this get tagged `large-oneoff` when the row is written,
# unless `rules.yaml` excludes their payee, narration or category.
LARGE_TXN_THRESHOLD=10000

# ── web UI (`make up` -> 127.0.0.1:8081) ─────────────────────────────────────
# Generate the first two with:  make web-password
# The plaintext password is never written here, to the repo, or to a log —
# only the Werkzeug hash. Quote the hash: it contains `$`.
PASSBOOK_WEB_USER=
PASSBOOK_WEB_PASSWORD_HASH=

# Flask session signing key. `make env` generates one.
PASSBOOK_WEB_SECRET=

# ── off-site backup (`make backup-remote`) ───────────────────────────────────
# Config only. THE PASSPHRASE IS NOT HERE AND MUST NOT BE PUT HERE — this file
# is read by make and by docker compose, and a passphrase stored beside the
# thing it protects is not protecting much. It lives at
# ~/.config/passbook/backup-passphrase (override with PASSBOOK_PASSPHRASE_FILE),
# mode 600, outside the repo. `make backup-remote` refuses to run otherwise.
#
# Create it ONLY with `make backup-passphrase`, which refuses to overwrite an
# existing one. A plain `> ` redirect would destroy a working passphrase
# silently and make every archive already in Drive permanently undecryptable.
#
# Losing that passphrase makes every uploaded archive permanently unreadable.

# rclone remote and folder, e.g. gdrive:passbook-backups. Created by
# `rclone config`, a manual interactive OAuth step — see README.
PASSBOOK_RCLONE_REMOTE=

# How many of each artefact to keep, locally and remotely.
PASSBOOK_BACKUP_KEEP=14

# OPTIONAL. Only needed if you upload a PDF statement instead of the XLS.
# Absent is fine until then; the loader's error names this variable.
#
# MEASURED: it is the LAST FOUR DIGITS of the account number, not the Customer
# ID. It is therefore NOT credential-class — it is the same four digits the UI
# already prints as the masked account (****NNNN), so masking it would be
# theatre. Earlier guidance in this file said to treat it as a credential; that
# was wrong and is corrected here.
#
# What IS worth knowing: the PDF's own protection is nominal. /V 1 /R 2 is
# RC4-40 over a four-digit secret — ten thousand combinations against a broken
# cipher. Never email these files or leave them in shared storage on the
# assumption that the password protects them. SPEC §6.8.
CANARA_PDF_PASSWORD=

#   PASSBOOK_SMTP_HOST=smtp.gmail.com
#   PASSBOOK_SMTP_PORT=587
#   PASSBOOK_SMTP_USER=you@gmail.com
#   PASSBOOK_SMTP_PASSWORD=<16-character App Password>
#
# THE PASSWORD MUST BE AN APP PASSWORD, not your Google account password.
# Google Account -> Security -> 2-Step Verification -> App passwords. 2-Step
# has to be on before that option appears. An account password is rejected with
# a 534 and passbook says so rather than telling you to reset anything.
#
# It is a credential: it is never logged, never echoed, and never returned by
# the API. Keep it out of the repo — .env is gitignored.
PASSBOOK_SMTP_HOST=
PASSBOOK_SMTP_PORT=587
PASSBOOK_SMTP_USER=
PASSBOOK_SMTP_PASSWORD=
# Where the invite goes. Defaults to PASSBOOK_SMTP_USER, which for Gmail is the
# address whose calendar it lands in — set it only to send somewhere else.
PASSBOOK_REMINDER_EMAIL=
